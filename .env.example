# ======================================================
# APPLICATION
# ======================================================
APP_NAME=AIKDAP
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000

API_V1_PREFIX=/api/v1

# ======================================================
# SECURITY
# ======================================================
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================================================
# DATABASE
# ======================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aikdap

# LOCAL DEVELOPMENT (docker-compose's `postgres` service, pgvector/pgvector:pg17).
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/aikdap

# PRODUCTION (Sprint 10A): Supabase-managed PostgreSQL + pgvector.
# Same driver (postgresql+psycopg), same SQLAlchemy/Alembic stack —
# only the host changes. Do NOT put the real value here or in git;
# this is a documented placeholder only.
#
# Use the SESSION POOLER host, not the Direct Connection host:
#   - Direct connections (db.<project-ref>.supabase.co) are IPv6-only
#     unless you buy Supabase's paid IPv4 add-on. Most local/CI/hosting
#     networks are IPv4-only, so a direct connection will simply fail
#     to resolve/connect there.
#   - Session Pooler (aws-<region>.pooler.supabase.com:5432) is
#     IPv4 on every plan tier INCLUDING free, and — unlike the
#     Transaction Pooler on port 6543 — supports prepared statements,
#     which SQLAlchemy's connection-pooled engine relies on. It is the
#     right mode for a long-running FastAPI/Celery process, as opposed
#     to serverless/edge functions (which should use the Transaction
#     Pooler on 6543 instead).
#   - Note the username changes to "postgres.<project-ref>" on the
#     pooler host (not plain "postgres").
#
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# ======================================================
# REDIS
# ======================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://redis:6379/0

# ======================================================
# CELERY
# ======================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ======================================================
# VECTOR DATABASE
# ======================================================
# CHROMA_HOST / CHROMA_PORT / CHROMA_PERSIST_DIRECTORY were removed in
# Sprint 11.2: pgvector (see EMBEDDING_DIMENSION below) has been the
# actual vector store since Sprint 9C. A repo-wide search found zero
# code references to any of the three -- they were never read by
# `Settings` and predate the pgvector migration.

# ======================================================
# AI MODELS
# ======================================================

# OpenAI Compatible
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Gemini
GEMINI_API_KEY=

# OpenRouter -- second fallback (Sprint 9H). See SECONDARY_FALLBACK_LLM.
OPENROUTER_API_KEY=

# DeepSeek -- kept configured but not part of the active chain
# (Sprint 9H); OpenRouter replaced it. See SECONDARY_FALLBACK_LLM.
DEEPSEEK_API_KEY=

# Embedding Model. LiteLLM "provider/model" notation, like every other
# model id here -- the prefix is what selects the backend:
#   ollama/bge-m3               local model server (needs Ollama running)
#   jina_ai/jina-embeddings-v3  hosted; for deployments with no local
#                               model server. Also 1024-dim, so it needs
#                               no migration -- but switching provider
#                               changes the vector space, so existing
#                               chunks must be re-embedded.
EMBEDDING_MODEL=ollama/bge-m3

# Jina AI: embeddings and reranking for hosted deployments. Not part of
# the text-generation fallback chain.
JINA_API_KEY=

# ======================================================
# LLM GATEWAY (Sprint 9A)
# ======================================================
# Model ids use LiteLLM "provider/model" notation, which is what
# routes the call to the right backend.

# Model used when a caller does not name one -- the primary provider.
DEFAULT_LLM=gemini/gemini-pro-latest

# Tried when the primary fails with something a different provider
# could survive. Leave empty to disable fallback.
FALLBACK_LLM=

# Tried when the first fallback also fails. Leave empty to disable.
# Sprint 9H: OpenRouter is the current second fallback, chosen by live
# testing against the real synthesis prompt (see docs/provider-resilience.md).
# The model lives inside this value, not a separate OPENROUTER_MODEL
# setting -- same convention FALLBACK_LLM uses for Groq's model.
SECONDARY_FALLBACK_LLM=

# Per-role models (wired into the research workflow in a later phase).
PLANNER_MODEL=gemini/gemini-pro-latest
SYNTHESIS_MODEL=gemini/gemini-pro-latest

# Generation defaults.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ---------------------------------------------------------------------
# PROVIDER RESILIENCE (Sprint 9G)
# ---------------------------------------------------------------------
# One retry policy, applied inside the gateway and nowhere else.
#
# LLM_MAX_RETRIES counts retries, not attempts: 2 means up to 3 calls.
# Only transient failures are retried -- per-minute rate limits, 503s,
# timeouts, connection errors. A spent daily quota is NEVER retried
# however this is set; it goes straight to the fallback.
#
# Backoff is exponential with equal jitter, capped by
# LLM_RETRY_MAX_DELAY: roughly 0.5-1s, then 1-2s, then 2-4s here.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=8.0

# How long a recorded provider failure keeps the gateway from calling
# that provider again. Every cooldown is bounded, so the breaker
# self-heals without operator action.
#
# The quota cooldown is the important one. Gemini's free tier resets at
# midnight Pacific, which the process cannot compute reliably, so the
# entry simply ages out after an hour instead: at worst one wasted
# request per hour re-confirms the quota is still spent.
LLM_QUOTA_COOLDOWN_SECONDS=3600
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
LLM_UNAVAILABLE_COOLDOWN_SECONDS=60
LLM_CONFIGURATION_ERROR_COOLDOWN_SECONDS=300

# Redis-backed provider health (Sprint 9H). Shared between the API and
# the Celery worker via Redis (reuses CELERY_BROKER_URL). Falls back to
# an in-process registry if Redis is unreachable.
LLM_HEALTH_REDIS_TIMEOUT=0.2
LLM_HEALTH_STATE_TTL_SECONDS=86400

# Stale research-run reconciliation (Sprint 9J). A ResearchRun stuck at
# status=running past this many seconds (started_at older than the
# cutoff) is recovered as failed on worker startup. Conservative default
# sized from the worst case the LLM retry/fallback chain can take in one
# attempt, not typical durations -- see settings.py for the full reasoning.
RESEARCH_RUN_STALE_AFTER_SECONDS=1200

# ---------------------------------------------------------------------
# GROUNDED SYNTHESIS (Sprint 9E)
# ---------------------------------------------------------------------
# Research synthesis answers from retrieved evidence only, using
# SYNTHESIS_MODEL above through the AIKDAP LLM gateway.
#
# true  -> GroundedSynthesizer (a real model answers from the evidence)
# false -> ExtractiveSynthesizer (no model; the answer is extracted)
#
# There is no automatic downgrade between them: if this is true and the
# model cannot be reached, the run fails with that reason rather than
# quietly answering by a different mechanism.
SYNTHESIS_GROUNDED=true
# Character budget for the evidence placed in the synthesis prompt.
# Evidence beyond it is excluded and therefore cannot be cited.
SYNTHESIS_MAX_EVIDENCE_CHARACTERS=12000

# ======================================================
# LOCAL DOCUMENT INTELLIGENCE (Sprint 9B) — Ollama + Qwen
# ======================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
QWEN_MODEL=qwen3.5:4b
QWEN_THINK=false
QWEN_MAX_TOKENS=4096
QWEN_TIMEOUT=180
QWEN_NUM_CTX=16384
QWEN_MAX_INPUT_CHARACTERS=24000

# Timeout for /health's Ollama liveness probe (Sprint 11.2) -- a plain
# GET on the root route, not a model call.
OLLAMA_HEALTH_TIMEOUT=3

# ======================================================
# LOCAL EMBEDDINGS (Sprint 9C) — BGE-M3 + pgvector
# ======================================================
# EMBEDDING_MODEL above is reused for the local model. Verified live
# against this host's Ollama: BGE-M3 returns 1024-dim vectors.
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=60

# ======================================================
# RERANKING (Sprint 9D) — BGE-Reranker-v2-m3
# ======================================================
# Served by llama.cpp (llama-server --reranking) rather than Ollama:
# Ollama has no rerank endpoint and crashes on this cross-encoder.
# The GGUF is BAAI/bge-reranker-v2-m3 Q8_0; llama-server runs on the
# host, so the containers reach it via host.docker.internal.
RERANKER_ENABLED=true
RERANKER_MODEL=bge-reranker-v2-m3
# Empty = use OLLAMA_BASE_URL.
RERANKER_BASE_URL=
RERANKER_ENDPOINT_PATH=/reranking
# llama-server's liveness route. GET-ing it loads no context and scores
# nothing, which is why /health probes this instead of reranking.
RERANKER_HEALTH_PATH=/health
RERANKER_HEALTH_TIMEOUT=3
RERANKER_TIMEOUT=60
RERANKER_CANDIDATE_K=20
RERANKER_TOP_K=5
RERANKER_MAX_DOCUMENT_CHARACTERS=4000

# Relevance gate (Sprint 9F). Minimum rerank_score for a chunk to be
# used as evidence. Reranking answers "in what order"; this answers
# "at all" -- without it, an unrelated question still receives the
# top_k least-bad chunks and reaches the synthesis model.
#
# This is a RAW BGE-Reranker-v2-m3 logit, not a probability. It was
# measured against this corpus, not chosen: see
# docs/relevance-calibration.md (70 labelled pairs; precision 0.818,
# recall 0.818 at this value). Recalibrate for a different corpus or
# reranker rather than reusing the number. Lower admits more.
RERANKER_RELEVANCE_THRESHOLD=-2.0

# ======================================================
# RESEARCH TOOLS
# ======================================================
# Currently unused (Sprint 11.2 audit: zero code references). The
# web_research pipeline node runs a deterministic, honestly-labelled
# mock provider (mock_web_v1) rather than a real external search --
# every result is marked simulated=True and excluded from citations.
# This key is a placeholder for wiring in a real provider (e.g.
# Tavily) later; setting it today has no effect.
TAVILY_API_KEY=
OPENALEX_API_KEY=
OPENALEX_TIMEOUT=20.0

# ======================================================
# FILE STORAGE
# ======================================================
UPLOAD_DIR=uploads

MAX_UPLOAD_SIZE_MB=100

# ======================================================
# LOGGING
# ======================================================
LOG_LEVEL=INFO

LOG_FORMAT=json

# ======================================================
# CORS
# ======================================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======================================================
# FRONTEND
# ======================================================
FRONTEND_URL=http://localhost:5173
