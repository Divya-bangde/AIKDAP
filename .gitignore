# Secrets — never commit. `.env` holds live API keys (Gemini, Groq,
# OpenAI) and database credentials; `.env.example` is the committed
# template and must contain empty placeholders only.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime artifacts
backend/uploads/
*.log

# Frontend (Sprint 9K)
# src/types/api.d.ts is generated (`npm run generate:api`) but
# committed on purpose, like a lockfile — `npm run build` must work
# without a live backend available to regenerate it.
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Local debugging artifacts: sprint screenshots, API response dumps
# (login/token dumps hold live JWTs), test-run transcripts and one-off
# investigation scripts. Git history keeps the ones already committed.
screenshots_*/
/*.png
/frontend/*.png
/backend/*.png
/backend/.e2e_scratch*
/backend/full_suite_*.txt
/backend/run_detail*.json
/backend/run_diag_*.json
/backend/run_start_*.json
/backend/login*.json
/backend/token*.txt
/backend/chunk_*_full.json
/backend/assets_now.json
/backend/evidence_workspace_fixture.json
/backend/_ask.py
/backend/block_providers.py
/backend/component_timing.py
/backend/ping_*.py
/backend/reconcile_now.py
/backend/repro_event_loop.py
